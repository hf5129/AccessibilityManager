<?xml version="1.0" encoding="utf-8"?>
<!--
    ⚠️ 本文件是 material 库 m3expressive_alert_dialog.xml 的**同名覆写**（整份复制后只改一处）。

    为什么是这一份：库里 alert dialog 骨架由主题属性 android:layout 决定，来源是 alertDialogStyle：
        MaterialAlertDialog.Material3           → @layout/m3_alert_dialog
        MaterialAlertDialog.Material3Expressive → @layout/m3expressive_alert_dialog   ← 本工程走这条
    本工程主题 Theme.Material3Expressive.DayNight.NoActionBar 经
    Base.Theme.Material3Expressive.Light/Dark 把 materialAlertDialogTheme 指到
    ThemeOverlay.Material3Expressive.MaterialAlertDialog ⇒ alertDialogStyle = …Material3Expressive
    ⇒ 实际加载的是本文件（2026-10-09 确认）。

    与库版的唯一差异：
      · contentPanel（消息文本那块，id=contentPanel）去掉 android:minHeight="48dp"
        —— 短消息不再被撑到 48dp，高度完全由内容决定。
        customPanel（setView 自定义内容的容器，id=customPanel）的 minHeight 保持库值不动。

    没改的地方（免得后来人以为漏了）：
      · 根节点 parentPanel 上的 android:clipChildren="true" 保持原样：
        ViewGroup 的 clipChildren 默认值就是 true，删掉这行等于没删（行为完全相同）；
        真要允许子 View 越界绘制得显式写 false，那才算有意义的改动。
      · textSpacerNoTitle / textSpacerNoButtons 的高度保持库里的
        @dimen/m3expressive_alert_dialog_top_padding / _bottom_padding，不写死具体值。

    同族文件现状：
      · m3_alert_dialog_actions.xml —— 保持原样，继续生效（本文件与库版 m3_alert_dialog.xml 都 include 它）。
      · m3_alert_dialog.xml          —— 已删除（app 侧不再覆写非 expressive 骨架；它在本工程主题下不被加载）。
      · m3_alert_dialog_title.xml    —— 已删除（只被非 expressive 骨架 include，早就不生效）。
-->
<androidx.appcompat.widget.AlertDialogLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|left|top"
    android:orientation="vertical"
    android:clipChildren="true"
    android:filterTouchesWhenObscured="true">

  <include layout="@layout/m3expressive_alert_dialog_title"/>

  <FrameLayout
      android:id="@+id/contentPanel"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <ImageView android:id="@+id/scrollIndicatorUp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="top"
        android:background="#1f000000"
        android:visibility="gone"
        android:contentDescription="@null"
        app:backgroundTint="?android:attr/colorForeground"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <android.widget.Space
            android:id="@+id/textSpacerNoTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/m3expressive_alert_dialog_top_padding"
            android:visibility="gone"/>

        <TextView
            android:id="@android:id/message"
            style="?attr/materialAlertDialogBodyTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="?attr/dialogPreferredPadding"
            android:paddingRight="?attr/dialogPreferredPadding"/>

        <android.widget.Space
            android:id="@+id/textSpacerNoButtons"
            android:layout_width="match_parent"
            android:layout_height="@dimen/m3expressive_alert_dialog_bottom_padding"
            android:visibility="gone"/>
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageView android:id="@+id/scrollIndicatorDown"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:background="#1f000000"
        android:visibility="gone"
        android:contentDescription="@null"
        app:backgroundTint="?android:attr/colorForeground"/>

  </FrameLayout>

  <FrameLayout
      android:id="@+id/customPanel"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp">

    <FrameLayout
        android:id="@+id/custom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
  </FrameLayout>

  <include layout="@layout/m3_alert_dialog_actions"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"/>

</androidx.appcompat.widget.AlertDialogLayout>
