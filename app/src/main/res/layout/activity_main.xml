<?xml version="1.0" encoding="utf-8"?>
<!--
    页面底 / 顶栏 / 列表底 = ?attr/colorSurface（浅 #FEF7FF / 深 #141218）
      —— 即 material 1.14 的**库默认**，不做任何覆写：
         · 窗口底：1.14 里 android:colorBackground = m3_sys_color_*_background = neutral98 / neutral6，
           与 ?attr/colorSurface 同值（background 角色已并入 surface）。
         · 顶栏：库 macro m3_comp_app_bar_container_color = ?attr/colorSurface
           （滚动后 m3_comp_app_bar_on_scroll_container_color = ?attr/colorSurfaceContainer；
            本页 liftOnScroll=false，不切）。
         · 列表底：ListView 自己不给底色时透出窗口底，也是 surface。

    列表行（item.xml 的 segmented ListItemCardView）= ?attr/colorSurfaceContainer
    （浅 #F3EDF7 / 深 #211F26）—— 2026-10-08 按用户要求直接取容器色档。

    为什么行卡片不是库默认：1.14 的列表项容器 macro 是
      m3_comp_list_list_item_container_color        = ?attr/colorSurface
      m3_comp_list_list_item_segmented_container_color = ?attr/colorSurface
    —— 与页面底**同色**（官方列表靠分隔线区分，不靠底色）。本项目用的是
    ListItemCardView（MaterialCardView 子类：cardElevation 0dp、无描边），
    形态上就是一张「实心卡片（filled card）」，所以按 1.14 官方的**卡片** token 取色：
      m3_comp_filled_card_container_color   = ?attr/colorSurfaceContainerHighest
      m3_comp_elevated_card_container_color = ?attr/colorSurfaceContainerLow（带阴影的卡片）
      m3_comp_outlined_card_container_color = ?attr/colorSurface（描边卡片，与底同色）
    上面三个只是卡片 token 备查；当前实际取的是容器色档 ?attr/colorSurfaceContainer
    （2026-10-08 按用户要求，比 ContainerLow 低一档、比 surface 高一档）。
    层级方向仍是"容器叠在 surface 上往上一档"：
    浅色下卡片比底暗（#F3EDF7 vs #FEF7FF）、深色下比底亮（#211F26 vs #141218）。
    弹窗内那四行卡片用同一个值（弹窗底是 colorSurfaceContainerHigh，卡片正好升一档）。-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/app_name"
            app:navigationIcon="@drawable/ic_accessibility"
            app:titleTextColor="?attr/colorOnSurfaceVariant">

            <!--
                「设置」入口：与左侧导航图标**同款的摆放**，只是位置在右边。
                刻意不用 MaterialButton：它自带 inset / iconSize / iconTint 一整套机制，
                会让图标既不正中也和左侧大小、颜色不一致。这里用 ImageButton，属性全部写在控件上：

                    · 24dp 图标（drawable 自身的尺寸）+ 12dp 内边距 = 48dp 之内正好居中
                      （48 - 24 = 24，两侧各 12dp），和左侧导航图标一样是 24dp 的字形；
                    · 颜色不写任何 tint —— 图标自带 ?attr/colorOnSurfaceVariant，
                      与左侧那个同一个色；
                    · 48dp 的控件在 56dp（?attr/actionBarSize）的工具栏里 layout_gravity
                      带 center_vertical 垂直居中，右侧 4dp 内缩和左侧对称；
                    · 背景必须用 ?attr/toolbarNavigationButtonBackground（material 把它定义为
                      @drawable/m3_default_control_background —— 带内缩的圆形涟漪）。
                      之前这里写 ?attr/selectableItemBackgroundBorderless，那是**无边界**涟漪、
                      半径按控件尺寸算，所以右侧水波纹比左侧大一大圈；
                      MaterialButton 看着正常，也是因为它的背景同样是有边界/有形状的 ripple。
                    · 尺寸按 56dp 的方形写死，且不设 marginEnd ——
                      左侧导航按钮就贴在起始边，右侧贴结束边才真正对称。

                改前这里是溢出菜单（onCreateOptionsMenu + menu/arrange.xml），菜单里只有一条
                「设置」、点了弹设置弹窗 —— 等于给一个按钮套了层菜单壳；那层壳还捎带一条 AppCompat
                依赖：abc_popup_menu_item_layout 的 @id/content 带
                style="@style/RtlOverlay.Widget.AppCompat.PopupMenuItem"（库给它 paddingEnd 16dp），
                为此得在 values-v26/ 写覆盖、还得靠版本限定符压过库的 values-v17。现在整条链都不要了。
            -->
            <ImageButton
                android:id="@+id/action_settings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/toolbarNavigationButtonBackground"
                android:contentDescription="@string/settings_title"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert" />
        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!--
      用 RecyclerView 而不是 ListView：列表增删 / 顺序变化的动画要靠它自带的 item 动画
      （DefaultItemAnimator）—— 新增淡入+位移、删除淡出+收起、顺序变化位移。
      原来那两个 android:divider / dividerHeight 是 ListView 专有属性，RecyclerView 没有，
      卡片之间的间距本来就由 item.xml 里卡片的 margin 控制，所以直接去掉。
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clipToPadding="false"
        android:paddingTop="0dp"
        android:paddingBottom="16dp"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
