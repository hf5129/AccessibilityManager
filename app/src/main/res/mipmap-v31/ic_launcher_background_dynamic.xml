<?xml version="1.0" encoding="utf-8"?>
<!--
    应用图标底色 —— 动态取色版（system_accent1_600 = 系统强调色 tone 40）。

    命名与位置：ic_launcher_background_dynamic，放在 mipmap-v31/（静态那套是
    mipmap/ic_launcher_background）。整套动态图标（ic_launcher_dynamic + 两个图层）
    都待在这个目录里 —— 因为它们引用的 system_accent1_* 是 API 31 才引入的框架色，
    放这儿等于声明"只在 API 31+ 存在"，低版本连这个资源都看不到。

    随壁纸/主题色变化：系统有 overlay（跟随壁纸取色）时是它算出的 tone 40，没有 overlay
    时是框架默认 #475D92 —— AOSP 对该色的注释：
      "This value can be overlaid at runtime by OverlayManager RROs."

    与前景 system_accent1_100 的对比度：兜底值 #475D92 / #D9E2FF = 5.01:1。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:height="108dp"
    android:width="108dp"
    android:viewportWidth="108.0"
    android:viewportHeight="108.0">
    <path
        android:fillColor="@android:color/system_accent1_600"
        android:pathData="M0,0H108V108H0Z" />
</vector>
